# Token from @BotFather (see README for steps)
TELEGRAM_BOT_TOKEN=

# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma-separated Telegram numeric user IDs allowed to use the bot in private chat.
# Run the bot with these empty, send /whoami, then fill in the IDs it prints.
ALLOWED_USER_IDS=

# Comma-separated Telegram chat IDs allowed to use the bot (e.g. your private group).
ALLOWED_CHAT_IDS=
